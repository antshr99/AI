terraform {
  required_version = ">= 1.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = "us-east-1"
}

# Security Group for PostgreSQL
resource "aws_security_group" "postgres_sg" {
  name        = "postgres-security-group"
  description = "Allow PostgreSQL access"

  # Allow PostgreSQL port 5432 from anywhere (for testing only!)
  ingress {
    description = "PostgreSQL"
    from_port   = 5432
    to_port     = 5432
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "PostgreSQL Security Group"
  }
}

# PostgreSQL RDS Instance
resource "aws_db_instance" "postgres" {
  identifier             = "my-postgres-db"
  engine                 = "postgres"
  engine_version         = "15.4"
  instance_class         = "db.t3.micro"
  allocated_storage      = 20
  storage_type           = "gp3"
  
  db_name                = "myappdb"
  username               = "dbadmin"
  password               = "MyPassword123!"
  
  publicly_accessible    = true
  skip_final_snapshot    = true
  
  vpc_security_group_ids = [aws_security_group.postgres_sg.id]
  
  backup_retention_period = 7
  
  tags = {
    Name = "My PostgreSQL Database"
  }
}

# Output the connection information
output "database_endpoint" {
  description = "Database connection endpoint"
  value       = aws_db_instance.postgres.endpoint
}

output "database_name" {
  description = "Database name"
  value       = aws_db_instance.postgres.db_name
}

output "database_username" {
  description = "Database username"
  value       = aws_db_instance.postgres.username
}

output "database_password" {
  description = "Database password"
  value       = "MyPassword123!"
  sensitive   = true
}

output "connection_command" {
  description = "Command to connect to database"
  value       = "psql -h ${aws_db_instance.postgres.address} -U ${aws_db_instance.postgres.username} -d ${aws_db_instance.postgres.db_name}"
}
